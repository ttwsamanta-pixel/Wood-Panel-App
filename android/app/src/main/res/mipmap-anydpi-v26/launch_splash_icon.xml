<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/brand_icon_background" />
    <!-- Splash masks magnify adaptive foregrounds; keep the lettering inside
         the central safe area, with equal padding on every side. -->
    <foreground>
        <inset android:inset="29%">
            <bitmap android:src="@mipmap/launch_icon" android:gravity="fill" />
        </inset>
    </foreground>
</adaptive-icon>


